# 2. Feature Importance using Random Forest
print("\n🌲 Random Forest Feature Importance:")
rf = RandomForestRegressor(n_estimators=100, random_state=42)
rf.fit(X, y)

feature_importance = pd.DataFrame({
    'feature': X.columns,
    'importance': rf.feature_importances_
}).sort_values('importance', ascending=False)

print(feature_importance)

# 3. Select Top K Features (let's keep top 8)
k = 8
selector = SelectKBest(score_func=f_regression, k=k)
X_selected = selector.fit_transform(X, y)

# Get selected feature indices
selected_indices = selector.get_support(indices=True)
selected_features = X.columns[selected_indices]

print(f"\n🎯 Top {k} Selected Features:")
for i, feature in enumerate(selected_features):
    print(f"   {i+1}. {feature}")

# 4. Create new dataframe with selected features
df_selected = pd.DataFrame(X_selected, columns=selected_features)
df_selected['rating'] = y.values

print(f"\n📊 Selected Data Shape: {df_selected.shape}")

# 5. Show correlation with target
