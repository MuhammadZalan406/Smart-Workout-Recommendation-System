import matplotlib.pyplot as plt
import seaborn as sns
import pandas as pd
import numpy as np

# 1. Create comparison dataframe
comparison_df = results_df.copy()

# 2. Visualize model comparison
fig, axes = plt.subplots(1, 3, figsize=(18, 5))

# Plot 1: R² Score Comparison
sns.barplot(data=comparison_df, x='Model', y='R² Score', 
            palette='viridis', ax=axes[0])
axes[0].set_title('Model Comparison - R² Score', fontsize=14)
axes[0].set_ylim(0, 0.8)
axes[0].tick_params(axis='x', rotation=45)
for i, v in enumerate(comparison_df['R² Score']):
    axes[0].text(i, v + 0.02, f'{v:.3f}', ha='center', fontsize=10)

# Plot 2: RMSE Comparison
sns.barplot(data=comparison_df, x='Model', y='RMSE', 
            palette='plasma', ax=axes[1])
axes[1].set_title('Model Comparison - RMSE', fontsize=14)
axes[1].tick_params(axis='x', rotation=45)
for i, v in enumerate(comparison_df['RMSE']):
    axes[1].text(i, v + 0.02, f'{v:.3f}', ha='center', fontsize=10)

# Plot 3: Training Time Comparison
sns.barplot(data=comparison_df, x='Model', y='Training Time (s)', 
            palette='coolwarm', ax=axes[2])
axes[2].set_title('Model Comparison - Training Time', fontsize=14)
axes[2].tick_params(axis='x', rotation=45)
for i, v in enumerate(comparison_df['Training Time (s)']):
    axes[2].text(i, v + 0.05, f'{v:.2f}s', ha='center', fontsize=10)

plt.tight_layout()
plt.show()

# 3. Radar chart for overall performance
print("\n📊 Performance Radar Chart:")
categories = ['R² Score', 'RMSE (inverted)', 'MAE (inverted)', 'Speed (inverted)']

# Normalize scores
r2_scores = comparison_df['R² Score'].values
rmse_scores = 1 - (comparison_df['RMSE'].values / comparison_df['RMSE'].max())
mae_scores = 1 - (comparison_df['MAE'].values / comparison_df['MAE'].max())
time_scores = 1 - (comparison_df['Training Time (s)'].values / comparison_df['Training Time (s)'].max())

fig = plt.figure(figsize=(8, 8))
ax = fig.add_subplot(111, polar=True)

angles = np.linspace(0, 2 * np.pi, len(categories), endpoint=False).tolist()
angles += angles[:1]

for i, model in enumerate(comparison_df['Model']):
    values = [r2_scores[i], rmse_scores[i], mae_scores[i], time_scores[i]]
    values += values[:1]
    ax.plot(angles, values, 'o-', linewidth=2, label=model)
    ax.fill(angles, values, alpha=0.1)

ax.set_xticks(angles[:-1])
ax.set_xticklabels(categories)
ax.set_ylim(0, 1)
ax.set_title('Model Performance Radar Chart', fontsize=16)
ax.legend(loc='upper right', bbox_to_anchor=(1.3, 1.0))

plt.show()

print("\n✅ MODEL COMPARISON COMPLETED!")

