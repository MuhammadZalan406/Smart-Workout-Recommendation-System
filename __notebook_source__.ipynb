# 2. Age Groups (Categorize age)
print("\n📊 Creating Age Groups...")
def age_group(age):
    if age < 25:
        return 'young'
    elif age < 40:
        return 'adult'
    elif age < 60:
        return 'middle_age'
    else:
        return 'senior'

df_fe['age_group'] = df_fe['age'].apply(age_group)
print(f"   Age groups created: {df_fe['age_group'].unique()}")

# 3. Encode age group
from sklearn.preprocessing import LabelEncoder
le_age = LabelEncoder()
df_fe['age_group_encoded'] = le_age.fit_transform(df_fe['age_group'])
print(f"   Age group encoded")

# 4. Rating Category (for classification if needed)
def rating_category(rating):
    if rating <= 2.0:
        return 'low'
    elif rating <= 3.5:
        return 'medium'
    else:
        return 'high'

df_fe['rating_category'] = df_fe['rating'].apply(rating_category)
print(f"   Rating categories created: {df_fe['rating_category'].unique()}")

# 5. Drop temporary columns
