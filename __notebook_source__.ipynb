import pandas as pd
import numpy as np

# 1. Load saved model and scaler
model = joblib.load('best_workout_model.pkl')
scaler = joblib.load('scaler.pkl')

# 2. Create a sample user (example)
sample_user = {
    'exercise_id': 1500,
    'persona_encoded': 1,  # low_stress
    'fitness_goal_encoded': 7,  # FAT_LOSS
    'experience_level_encoded': 5,  # intermediate
    'injury_constraint_encoded': 3,  # shoulder_injury
    'bodyPart_encoded': 34,  # upper arms
    'equipment_encoded': 58,  # dumbbell
    'target_muscle_encoded': 3  # biceps
}

# 3. Convert to DataFrame
sample_df = pd.DataFrame([sample_user])

print("👤 Sample User Profile:")
for key, value in sample_user.items():
    print(f"   {key}: {value}")

# 4. Scale features
sample_scaled = scaler.transform(sample_df)

# 5. Make prediction
predicted_rating = model.predict(sample_scaled)[0]

print(f"\n⭐ Predicted Workout Rating: {predicted_rating:.2f}/5.0")

# 6. Interpret the rating
if predicted_rating >= 4.0:
    recommendation = "Excellent match! This workout is highly recommended for you! 🏆"
elif predicted_rating >= 3.0:
    recommendation = "Good match! This workout could work well for you. 💪"
elif predicted_rating >= 2.0:
    recommendation = "Average match. Consider other options. 🤔"
else:
    recommendation = "Poor match. Not recommended. ❌"

print(f"\n📝 Recommendation: {recommendation}")

